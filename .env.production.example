NODE_ENV=production

PORT=3000

DATABASE_URL=postgresql://USERNAME:PASSWORD@DATABASE_HOST:5432/ludomada

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS

# Comma-separated allowed origins
CORS_ORIGINS=https://api.example.com,https://app.example.com

# Set true only when running behind Nginx / reverse proxy / Cloudflare
TRUST_PROXY=true

# ==============================
# MVola production (GO LIVE)
# ==============================
# Do NOT commit real values. Store them only in the production secret manager.
# These credentials/values are issued by MVola Developer after approval.
MVOLA_CLIENT_ID=REPLACE_WITH_MVOLA_PRODUCTION_CLIENT_ID
MVOLA_CLIENT_SECRET=REPLACE_WITH_MVOLA_PRODUCTION_CLIENT_SECRET
# Keep the official MVola production base URL exactly as supplied in the approved API documentation.
MVOLA_BASE_URL=REPLACE_WITH_MVOLA_PRODUCTION_BASE_URL
# Public HTTPS endpoint registered/approved for MVola callbacks/webhooks, if required by the approved API flow.
MVOLA_CALLBACK_URL=https://api.example.com/api/payments/MVOLA/webhook

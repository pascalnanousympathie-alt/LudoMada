{
  "name": "ludo-mada-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "prisma": "node node_modules/prisma/build/index.js",
    "test": "node node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "test:integration": "node node_modules/jest/bin/jest.js --runInBand tests/integration",
    "test:concurrency": "node node_modules/jest/bin/jest.js --runInBand tests/concurrency",
    "test:security": "node node_modules/jest/bin/jest.js --runInBand tests/security",
    "ci": "npm run db:generate && npm run db:migrate && npm test",
    "test:all": "node node_modules/jest/bin/jest.js --runInBand",
    "staging:check": "npm run db:generate && npm run db:migrate && npm run test:all",
    "start:prod": "node dist/server.js",
    "migrate:prod": "node node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.3",
    "@types/pg": "^8.23.1",
    "artillery": "^2.0.34",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}

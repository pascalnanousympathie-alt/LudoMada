DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ludomada"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
PORT=3000

NODE_ENV=development

# Airtel Money UAT collection (disabled until explicitly enabled + credentials are present)
PAYMENTS_AIRTEL_SANDBOX_ENABLED=false
AIRTEL_COUNTRY=MG
AIRTEL_CURRENCY=MGA
AIRTEL_TIMEOUT_MS=15000
# Optional HTTPS relay base URL (e.g. https://<oracle-ip>.sslip.io)
# AIRTEL_API_BASE_URL=
# Shared secret required by the relay; keep SET only in Railway/secret storage
# AIRTEL_RELAY_TOKEN=
AIRTEL_MESSAGE_SIGNING_ENABLED=true
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=

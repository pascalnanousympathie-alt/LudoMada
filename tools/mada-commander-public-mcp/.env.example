# Configure these in the deployment platform's secret manager. Never commit real values.
# Public HTTPS origin for this service only, e.g. the exact Vercel production origin.
MADA_PUBLIC_BASE_URL=
# Dedicated Postgres database/schema for Mada Commander. Do NOT point this at the LudoMada game database.
MADA_COMMANDER_DATABASE_URL=
# Google OAuth web client configured with callback: MADA_PUBLIC_BASE_URL/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OpenAI supports Client ID Metadata Documents (CIMD); only exact chatgpt.com client metadata paths are accepted.
# Set true after reviewing the CIMD implementation. Alternatively use explicit client ID + redirect allowlists below.
MADA_OAUTH_CIMD_ENABLED=true
MADA_OAUTH_CLIENT_IDS=
# Exact callback URL(s) for preconfigured clients; comma-separated. CIMD clients are checked against their metadata document.
MADA_OAUTH_REDIRECT_URIS=
# Optional CORS origin allowlist, comma-separated. Defaults cover official ChatGPT web origins plus same origin.
MADA_CORS_ORIGINS=https://chatgpt.com,https://chat.openai.com
# Set NODE_ENV=production in the deployed service. No local private runtime secrets are required.
NODE_ENV=production
# Exact plain-text challenge token generated by OpenAI's submission portal (do not invent it).
OPENAI_APPS_CHALLENGE_TOKEN=

{
  "name": "mada-commander-public-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated least-privilege public MCP service for Mada Commander; it never imports the private Termux Commander.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "migrate": "node scripts/migrate.mjs",
    "audit": "node scripts/audit-public-boundary.mjs",
    "verify": "npm run audit && npm test",
    "test:tenant-isolation": "node scripts/test-tenant-isolation.mjs",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}

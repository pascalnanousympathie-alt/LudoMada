{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/router.mjs": {
      "maxDuration": 30,
      "includeFiles": "*.html"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/router?route=domain-challenge"
    },
    {
      "source": "/api/auth/session",
      "destination": "/api/router?route=auth-session"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/router?route=auth-logout"
    },
    {
      "source": "/api/oauth/connections",
      "destination": "/api/router?route=oauth-connections"
    },
    {
      "source": "/api/oauth/connections/revoke",
      "destination": "/api/router?route=oauth-connections-revoke"
    },
    {
      "source": "/api/account/delete",
      "destination": "/api/router?route=account-delete"
    },
    {
      "source": "/api/agent/list",
      "destination": "/api/router?route=agent-list"
    },
    {
      "source": "/api/agent/revoke",
      "destination": "/api/router?route=agent-revoke"
    },
    {
      "source": "/mcp",
      "destination": "/api/router?route=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/router?route=oauth-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/router?route=oauth-server"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/router?route=oauth-authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/router?route=oauth-token"
    },
    {
      "source": "/oauth/revoke",
      "destination": "/api/router?route=oauth-revoke"
    },
    {
      "source": "/oauth/google/start",
      "destination": "/api/router?route=google-start"
    },
    {
      "source": "/oauth/google/callback",
      "destination": "/api/router?route=google-callback"
    },
    {
      "source": "/oauth/approve",
      "destination": "/api/router?route=oauth-approve"
    },
    {
      "source": "/api/agent/pair-code",
      "destination": "/api/router?route=agent-pair-code"
    },
    {
      "source": "/api/agent/enroll",
      "destination": "/api/router?route=agent-enroll"
    },
    {
      "source": "/api/agent/heartbeat",
      "destination": "/api/router?route=agent-heartbeat"
    },
    {
      "source": "/api/agent/poll",
      "destination": "/api/router?route=agent-poll"
    },
    {
      "source": "/api/agent/complete",
      "destination": "/api/router?route=agent-complete"
    },
    {
      "source": "/api/health",
      "destination": "/api/router?route=health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}

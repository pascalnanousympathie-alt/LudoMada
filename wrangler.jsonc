{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludomada-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "TRUST_PROXY": "true",
    "CLOUDFLARE_WORKERS": "true",
    "PG_POOL_MAX": "1"
  }
}
